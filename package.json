{
  "name": "winperf-mcp",
  "version": "1.0.0",
  "description": "MCP server for Windows performance troubleshooting",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-presentmon.ps1",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "windows",
    "performance",
    "monitoring",
    "troubleshooting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "koffi": "^2.15.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
